  bottom=8pt,
  title={\sffamily\bfseries\color{NEBorder}対象条文}
}


% ---------------------------------------------------------
% Japanese legal-text citation
% ---------------------------------------------------------
% Hierarchical indentation modeled on Japanese legal documents.
\newcommand{\lawbook}[2]{%
  \noindent\hspace*{0em}{#1}\quad #2\\}
\newcommand{\lawchapter}[2]{%
  \noindent\hspace*{1.5em}{#1}\quad #2\\}
\newcommand{\lawsection}[2]{%
  \noindent\hspace*{3em}{#1}\quad #2\\}
\newcommand{\lawsubsection}[2]{%
  \noindent\hspace*{4.5em}{#1}\quad #2\\}
\newcommand{\lawdivision}[2]{%
  \noindent\hspace*{6em}{#1}\quad #2\\}

% #1 = article number, #2 = article heading
% 条文番号の幅を保存する長さ
\newlength{\lawlabelwidth}

\newenvironment{lawarticle}[2]{%
  \par\medskip
  \noindent
  \if\relax\detokenize{#2}\relax
  \else
    （#2）\par
  \fi
  %
  % 条文番号＋空白の実際の幅を測る
  \settowidth{\lawlabelwidth}{#1\quad}%
  %
  % 2行目以降を条文番号の幅だけ字下げ
  \hangindent= 1em %\lawlabelwidth
  \hangafter=1
  %
  % 1行目には条文番号を配置
  \makebox[\lawlabelwidth][l]{#1\quad}%
  \ignorespaces
}{%
  \par\medskip
}

% Paragraph within an article: ２, ３, ...
\newcommand{\lawparagraph}[1]{%
  \par\smallskip
  \noindent
  \hangindent=1em
  \hangafter=1
  \makebox[2em][l]{#1}%
  \ignorespaces}

% Numbered item: 一, 二, 三, ...
\newcommand{\lawitem}[1]{%
  \par\smallskip
  \noindent
  \hspace*{1.0em}%
  \hangindent=2em
  \hangafter=1
  \makebox[2em][l]{#1}%
  \ignorespaces}

\newenvironment{lawstructure}{%
  \par\smallskip
  \begingroup
  \setlength{\parindent}{0pt}
  \setlength{\parskip}{0pt}
}{%
  \par\endgroup\smallskip}
