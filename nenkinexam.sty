% ---------------------------------------------------------
% Basic question components
% ---------------------------------------------------------
\newcounter{question}

\newcommand{\questionnumber}{%
  \stepcounter{question}\arabic{question}%
}

\newcommand{\questiontitle}[2]{%
  \begin{tcolorbox}[
    enhanced,
    colback=white,
    colframe=#1,
    boxrule=0pt,
    borderline west={4pt}{0pt}{#1},
    arc=2mm,
    left=10pt,
    right=10pt,
    top=7pt,
    bottom=7pt
  ]
  {\sffamily\bfseries\color{#1}QUESTION \questionnumber}
  \hfill
  {\sffamily\small\color{NEGray}#2}
  \end{tcolorbox}
}


\newenvironment{fillblank}[1][]{%
  \questiontitle{NESecondary}{\ifx\relax#1\relax\else\quad #1\fi}%
}{}

\newenvironment{truefalse}
  {\questiontitle{NEOrange}{正誤判定}}
  {}

\newenvironment{shortanswer}
  {\questiontitle{NEGreen}{要件・定義・短答}}
  {}

\newtcolorbox{answerbox}{
  enhanced,
  breakable,
  colback=NEPrimary!4,
  colframe=NEPrimary,
  borderline west={5pt}{0pt}{NEPrimary},
  boxrule=0pt,
  arc=2mm,
  left=10pt,
  right=10pt,
  top=8pt,
  bottom=8pt,
  title={\sffamily\bfseries\color{NEBorder}解答}
}

\newtcolorbox{explanationbox}{
  enhanced,
  breakable,
  colback=NEGray!5,
  colframe=NEBorder,
  boxrule=.6pt,
  arc=2mm,
  left=10pt,
  right=10pt,
  top=8pt,
  bottom=8pt,
  title={\sffamily\bfseries\color{NESecondary}メモ}
}


\newtcolorbox{InyouJobunbox}{
